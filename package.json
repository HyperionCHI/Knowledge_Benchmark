{
  "name": "knowledge-workbench",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "pnpm run license:generate && vinext build && pnpm run license:copy",
    "start": "vinext start",
    "test": "pnpm run build && pnpm run test:permissions && pnpm run test:auth && pnpm run test:records && pnpm run test:todos && pnpm run test:recurrence && pnpm run test:attachment-access && pnpm run test:restore && pnpm run test:markdown && node --test tests/rendered-html.test.mjs",
    "test:permissions": "tsx --test tests/workspace-permissions.test.ts",
    "test:auth": "tsx tests/auth-flow.test.ts",
    "test:records": "tsx tests/workspace-records.test.ts",
    "test:todos": "tsx tests/todos.test.ts",
    "test:recurrence": "tsx --test tests/todo-recurrence.test.ts",
    "test:attachment-access": "tsx --test tests/knowledge-attachment-access.test.ts",
    "test:markdown": "tsx --test tests/knowledge-markdown.test.tsx tests/editor-behavior.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "backup": "node scripts/backup-workbench.mjs",
    "restore": "node scripts/restore-workbench.mjs",
    "test:restore": "node --test tests/restore-workbench.test.mjs",
    "license:generate": "node scripts/generate-third-party-notices.mjs",
    "license:check": "node scripts/generate-third-party-notices.mjs --check",
    "license:copy": "node scripts/copy-license-materials.mjs",
    "release:check": "node scripts/check-release-readiness.mjs"
  },
  "dependencies": {
    "better-auth": "^1.6.29",
    "better-sqlite3": "^13.0.3",
    "cherry-markdown": "^0.11.9",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.3",
    "katex": "0.16.47",
    "lucide": "1.31.0",
    "mermaid": "11.17.0",
    "morphicons": "^1.7.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13"
  },
  "type": "module"
}
