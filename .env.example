# 生产环境必须替换为至少 32 字节的随机值，且不要提交真实值。
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-bytes
# 必须与用户实际访问的完整地址一致。
BETTER_AUTH_URL=http://localhost:3001
# 多个来源用英文逗号分隔；内网或反向代理部署时加入用户实际访问的完整来源。
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# 建议在生产环境中使用发布目录之外的绝对路径。
WORKBENCH_DB_PATH=./data/workbench.sqlite
WORKBENCH_ATTACHMENT_DIR=./data/attachments
